+class SiteReadinessTests(unittest.TestCase):
+    def test_required_public_routes_exist(self):
+        required = [
+            "index.html",
+            "pricing.html",
+            "scanner.html",
+            "privacy.html",
+            "founding-audit.html",
+            "sample-audit.html",
