{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pri8771/autonomous_apps/blob/main/state/audit/schema.json",
  "title": "CommerceLint autonomous run event",
  "type": "object",
  "required": [
    "schema_version",
    "event_id",
    "run_id",
    "workflow",
    "status",
    "started_at_utc",
    "ended_at_utc",
    "started_at_local",
    "ended_at_local",
    "timezone",
    "trigger",
    "task_selected",
    "decision_summary",
    "evidence_consulted",
    "action_taken",
    "verification",
    "metrics_before",
    "metrics_after",
    "blockers",
    "failures_retries",
    "lessons",
    "next_action",
    "links",
    "commit_hashes",
    "backfilled",
    "backfill_notes",
    "source",
    "redaction_applied"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "workflow": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "ended_at_utc": {"type": "string", "format": "date-time"},
    "started_at_local": {"type": "string", "format": "date-time"},
    "ended_at_local": {"type": "string", "format": "date-time"},
    "timezone": {"const": "America/New_York"},
    "trigger": {"type": "string"},
    "task_selected": {
      "type": "object",
      "required": ["id", "title", "type"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "title": {"type": "string"},
        "type": {"type": ["string", "null"]}
      }
    },
    "decision_summary": {"type": "string"},
    "evidence_consulted": {"type": "array", "items": {"type": "string"}},
    "action_taken": {"type": "object"},
    "verification": {"type": "object"},
    "metrics_before": {"type": "object"},
    "metrics_after": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "failures_retries": {"type": "array", "items": {"type": "string"}},
    "lessons": {"type": "array", "items": {"type": "string"}},
    "next_action": {"type": "string"},
    "links": {"type": "array", "items": {"type": "string"}},
    "commit_hashes": {"type": "array", "items": {"type": "string"}},
    "backfilled": {"type": "boolean"},
    "backfill_notes": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "object"},
    "redaction_applied": {"type": "boolean"}
  },
  "additionalProperties": false
}
