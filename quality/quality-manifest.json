{
  "$schema": "https://raw.githubusercontent.com/pri8771/iOS_app_factory_rules/main/schemas/quality-manifest.schema.json",
  "application": {
    "name": "Autonomous Apps",
    "projectType": "new",
    "platforms": ["macos"]
  },
  "requirements": {
    "accessibility": true,
    "keyboardNavigation": true,
    "responsiveLayoutTests": true,
    "darkMode": true,
    "reducedMotion": true,
    "persistenceRelaunchTests": true,
    "restartRecoveryTests": true,
    "fakeDataIsolation": true,
    "completionEvidence": true,
    "independentReview": true,
    "localOnlyPolicyTests": true,
    "secretRedactionTests": true,
    "processCancellationTests": true,
    "databaseMigrationTests": true,
    "signedRelease": true,
    "hardenedRuntime": true,
    "notarization": true,
    "cleanAccountInstallTest": true
  },
  "requiredTestSuites": [
    "schema",
    "rust-unit",
    "frontend-unit",
    "storage-integration",
    "workflow-integration",
    "scheduler-concurrency",
    "git-process-integration",
    "security",
    "accessibility",
    "ui-smoke",
    "recovery",
    "performance-baseline",
    "packaged-macos-smoke"
  ],
  "qualityStandardVersion": "0.4.0"
}
