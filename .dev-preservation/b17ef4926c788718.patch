+            matrix.append(row)
+
+        # Lite comparison requires 2+ scored pages
+        strong = (FIXTURES / "strong.html").read_text(encoding="utf-8")
+        missing = (FIXTURES / "missing-offer.html").read_text(encoding="utf-8")
+        lite = page_reports_from_html(
