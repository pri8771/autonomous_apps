{
  "$schema": "https://raw.githubusercontent.com/pri8771/iOS_app_factory_rules/main/schemas/project-context.schema.json",
  "projectName": "Autonomous Apps",
  "projectType": "new",
  "lifecycleStatus": "planned",
  "platforms": ["macos"],
  "frameworks": ["Tauri 2", "React", "TypeScript", "Vite", "Rust", "SQLite"],
  "registeredAt": "2026-07-20",
  "existingCodeBaselineRequired": false,
  "constraints": {
    "localFirst": true,
    "backendAllowed": true,
    "thirdPartyDependenciesAllowed": true,
    "supportedArchitecture": "apple-silicon",
    "minimumMacOS": "14.0",
    "hostedBackendRequired": false,
    "publicPluginSystemAllowed": false
  },
  "productCapabilities": {
    "primaryApplication": "macos-desktop",
    "targetProductTypes": ["ios", "web"],
    "futureBrowserCompanion": true,
    "multiUserV1": false
  },
  "branchPolicy": {
    "development": "dev",
    "qualityAssurance": "qa",
    "stable": "main",
    "taskBranchesFrom": "dev",
    "directProtectedBranchWritesAllowed": false
  },
  "libraryDiscovery": {
    "policy": "reuse_first",
    "localCatalog": ".factory/library-catalog.json",
    "centralCatalog": "pri8771/iOS_app_factory_rules/registry/libraries.json",
    "reusableComponentsDocument": "docs/REUSABLE_COMPONENTS.md"
  },
  "agentEntryPoints": {
    "generic": "AGENTS.md",
    "claudeCode": "CLAUDE.md",
    "gemini": "GEMINI.md",
    "cursor": ".cursor/rules/app-factory.mdc",
    "githubCopilot": ".github/copilot-instructions.md",
    "canonicalLocalRules": ".factory/AGENTS.factory.md"
  },
  "requiredReading": [
    "AGENTS.md",
    ".factory/repository-map.json",
    ".factory/project-context.json",
    ".factory/standard-lock.json",
    ".factory/AGENTS.factory.md",
    ".factory/library-catalog.json",
    "docs/README.md",
    "docs/STATUS.md",
    "quality/quality-manifest.json",
    "planning/READINESS_GATE.md"
  ]
}
